# === UWU service configuration ===
# PostgreSQL connection (used inside docker-compose, host "db")
DATABASE_URL=postgresql+asyncpg://uwu:uwu@db:5432/uwu?ssl=disable

# Admin account (created on first start)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@example.com

# Security
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Окружение: development | production. В production небезопасные
# SECRET_KEY/ADMIN_PASSWORD блокируют запуск (fail-fast). Для деплоя в
# production задайте ENVIRONMENT=production и надёжные SECRET_KEY/ADMIN_PASSWORD.
ENVIRONMENT=development

# Default working currency
DEFAULT_CURRENCY=RUB

# UI language default (ru | en)
DEFAULT_LANGUAGE=ru

# Каталог загружаемых изображений товаров
UPLOADS_DIR=/app/uploads

# === Семантический поиск (pgvector + эмбеддинги) ===
# OpenAI-совместимый эндпоинт эмбеддингов. Пусто — семантический поиск
# работает в fallback-режиме (по ключевым словам).
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# === AI-агент (отдельный сервис uwu-ai-agent) ===
# URL webhook-эндпоинта агента (POST /webhook), на который ядро отправляет
# уведомления о новых входящих сообщениях в чатах с автоответом. Пусто —
# уведомление выключено. Модель/токен/параметры LLM задаются в самом сервисе
# uwu-ai-agent (его .env), а не здесь — в админке ядра управляются только
# промпты и права агента.
AGENT_WEBHOOK_URL=
AGENT_WEBHOOK_TIMEOUT=3.0

# API-ключ агента: ядро при старте гарантирует существование ключа с этим
# значением (идемпотентно). Тот же ключ передаётся сервису uwu-ai-agent.
AGENT_API_KEY=uwu-dev-agent-key-change-me

# Временный пароль по умолчанию для аккаунтов покупателей, создаваемых
# AI-агентом автоматически (по номеру телефона). Покупатель входит в личный
# кабинет с этим паролем и может сменить его.
CUSTOMER_DEFAULT_PASSWORD=1242

# === LLM для uwu-ai-agent (OpenAI-совместимый API) ===
# Пустой AGENT_LLM_API_KEY — агент работает в fallback-режиме (без LLM).
AGENT_LLM_BASE_URL=
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=gpt-4o-mini
