# === uwu-ai-agent configuration ===
# Базовый URL ядра UWU (REST API). В docker-compose — http://app:8000.
CORE_BASE_URL=http://localhost:8000

# API-ключ агента. Должен совпадать с AGENT_API_KEY, переданным ядру UWU
# (ядро при старте гарантирует существование ключа с таким значением).
AGENT_API_KEY=uwu-dev-agent-key-change-me

# === LLM (OpenAI-совместимый API) ===
# Пустой LLM_API_KEY — агент работает в fallback-режиме (детерминированный
# ответчик без LLM). Задайте ключ для реальных LLM-ответов.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=512
LLM_TIMEOUT=30.0

# === Цикл обработки ===
# Интервал опроса /api/agent/inbox (сек) и признак включения polling.
POLL_INTERVAL=2.0
ENABLE_POLLING=true
MAX_HISTORY=20

# === Сервис ===
LOG_LEVEL=INFO
